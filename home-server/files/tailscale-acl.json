// Tailscale ACL for a small home tailnet.
// Names and IPs are examples, adjust to yours.
// Save your previous ACL before replacing it: the Tailscale default allows
// everything, while a broken ACL locks everything out. The default is in
// tailscale-acl-default-original.json next to this file as a revert target.
//
// Idea: laptops get full access (administration), the phone reaches the
// services on the main server plus the chat, shared guests reach only the
// chat. Everything else is implicitly denied — once "grants" is set, the
// tailnet is default-deny.
//
// IMPORTANT: This only governs traffic THROUGH Tailscale. At home on WLAN,
// access to the main server's LAN address goes directly over the LAN and is
// not affected. One exception: the chat is reached by its MagicDNS name,
// which resolves to the Tailscale address — that traffic always goes through
// Tailscale, even on the same WLAN. Without the phone's grant on "calc" the
// app is unreachable from your own phone anywhere.
{
	"hosts": {
		"laptop-1": "100.101.1.20",
		"laptop-2": "100.101.1.21",
		"phone":    "100.101.1.30",
		"pi":       "100.101.1.10",  // main server (tailnet IP)
		"pi-lan":   "192.168.0.10",  // main server (LAN IP via subnet router)
		"calc":     "100.101.1.40",  // chat node (Tailscale container on the main server)
	},

	"acls": [],

	"grants": [
		// Shared guest (node sharing on the chat node): the app on 443 and
		// the TURN relay, nothing else. No SSH, no Immich, no Paperless, no
		// Samba, no subnet route into the LAN.
		//
		// This grant is also what keeps the relay from becoming a stepping
		// stone: coturn allows the whole 100.64.0.0/10 range as a peer, but
		// there is no grant with the chat node as "src" — traffic originating
		// there is dropped.
		{
			"src": ["autogroup:shared"],
			"dst": ["calc"],
			"ip":  ["tcp:443", "tcp:3478", "udp:3478", "udp:49160-49200"],
		},

		// Own phone: same access to the chat. Not optional, see the MagicDNS
		// note in the header.
		{
			"src": ["phone"],
			"dst": ["calc"],
			"ip":  ["tcp:443", "tcp:3478", "udp:3478", "udp:49160-49200"],
		},

		// Phone: Immich (2283), Paperless (8000) and Samba (445) on the main
		// server, reachable via both addresses.
		// Router admin page, SSH and all other LAN devices: denied.
		{
			"src": ["phone"],
			"dst": ["pi-lan", "pi"],
			"ip":  ["2283", "8000", "445"],
		},

		// Laptops: full access to the tailnet and (via subnet router) the LAN
		{
			"src": ["laptop-1"],
			"dst": ["*"],
			"ip":  ["*"],
		},
		{
			"src": ["laptop-2"],
			"dst": ["*"],
			"ip":  ["*"],
		},
	],
}
