// Tailscale ACL for a small home tailnet.
// Names match the machine names in the admin console, adjust to yours.
// Idea: laptops get full access (administration), the phone only reaches
// the three services on the main server, everything else is implicitly denied.
// IMPORTANT: This only governs traffic THROUGH Tailscale (i.e. remote).
// At home on WLAN, traffic goes directly over the LAN and is not affected.
// Save your previous ACL before replacing it, the default is "allow all".
{
	"hosts": {
		"laptop-1": "100.101.1.20",
		"laptop-2": "100.101.1.21",
		"phone":    "100.101.1.30",
		"pi":       "100.101.1.10",  // main server (tailnet IP)
		"pi-lan":   "192.168.0.10",  // main server (LAN IP via subnet router)
	},

	"acls": [
		// Laptops: full access to the tailnet and (via subnet router) the LAN
		{
			"action": "accept",
			"src":    ["laptop-1", "laptop-2"],
			"dst":    ["*:*"],
		},

		// Phone: only Immich (2283), Paperless (8000) and Samba (445)
		// on the main server, reachable via both addresses.
		// Router admin page, SSH and all other LAN devices: denied.
		{
			"action": "accept",
			"src":    ["phone"],
			"dst": [
				"pi-lan:2283,8000,445",
				"pi:2283,8000,445",
			],
		},
	],
}
